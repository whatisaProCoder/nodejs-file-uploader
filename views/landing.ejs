<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ShareFY</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="shortcut icon" href="/brand-icon.svg" type="image/x-icon">
</head>

<body>
  <%- include("./partials/header") %>
    <div class="gradient"></div>
    <div class="content-container">
      <div class="content">
        <div class="hero-section">
          <div class="hero-text">Upload, organize, and share files — <span>effortlessly.</span></div>
          <a href="/auth/sign-up" class="action-button">Get Started</a>
        </div>

        <div class="feature-section">
          <div class="section-title">What We Offer</div>
          <div>
            <div class="grid">
              <div class="card">
                <div class="icon-container">
                  <img src="/secure-icon.svg" alt="Secure">
                </div>
                <div class="text">
                  <div class="title">Secure Storage</div>
                  <div class="subtext">Your files are stored safely and accessible only to you.</div>
                </div>
              </div>

              <div class="card">
                <div class="icon-container">
                  <img src="/upload-icon.svg" alt="Upload">
                </div>
                <div class="text">
                  <div class="title">Simple Upload</div>
                  <div class="subtext">Drag, drop, and manage files with an intuitive interface.</div>
                </div>
              </div>

              <div class="card">
                <div class="icon-container">
                  <img src="/workspace-icon.svg" alt="Workspace">
                </div>
                <div class="text">
                  <div class="title">Organized Workspace</div>
                  <div class="subtext">Everything structured with folders and easy navigation.</div>
                </div>
              </div>

              <div class="card">
                <div class="icon-container">
                  <img src="/web-icon.svg" alt="Web">
                </div>
                <div class="text">
                  <div class="title">Access Anywhere</div>
                  <div class="subtext">Your files stay with you available whenever you need them.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-representation">
          <img src="/dashboard.png" alt="Dashboard">
          <div class="subtext">ShareFY Version 1.0 - Public Release</div>
        </div>

        <div class="tech-stack-section">
          <div class="title-group">
            <div class="line-1"></div>
            <div class="title">Tech Stack</div>
            <div class="line-2"></div>
          </div>

          <div class="marquee-container">
            <div class="marquee-content">
              <div class="item">TypeScript</div>
              <div class="item">Node.js</div>
              <div class="item">Express</div>
              <div class="item">EJS</div>
              <div class="item">CSS</div>
              <div class="item">PostgreSQL</div>
              <div class="item">Prisma ORM</div>
              <div class="item">Passport.js</div>
              <div class="item">Cloudinary API</div>

              <div class="item">TypeScript</div>
              <div class="item">Node.js</div>
              <div class="item">Express</div>
              <div class="item">EJS</div>
              <div class="item">CSS</div>
              <div class="item">PostgreSQL</div>
              <div class="item">Prisma ORM</div>
              <div class="item">Passport.js</div>
              <div class="item">Cloudinary API</div>
            </div>
          </div>
        </div>

        <div class="footer">Built by <a href="github.com/whatisaProCoder">@whatisaProCoder</a> | The Odin Project
        </div>
      </div>
</body>

<script src="/script.js"></script>

</html>