<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ShareFY</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="shortcut icon" href="/brand-icon.svg" type="image/x-icon">
</head>

<body>
  <%- include("./partials/header") %>
    <div class="content-container">
      <div class="content">
        <div class="banner">
          <div class="greeting">
            <div class="text">Welcome, <%= currentUser?.firstName %>!
            </div>
            <div class="subtext">Upload, organize, and manage your files effortlessly.</div>
          </div>
          <div class="metrics">
            <div class="metric">
              <div class="metrics-title">Total Folders</div>
              <div class="value">10</div>
            </div>
            <div class="line"></div>
            <div class="metric files">
              <div class="metrics-title">Total Files</div>
              <div class="value">20</div>
            </div>
            <div class="line files"></div>
            <div class="metric">
              <div class="metrics-title">Storage Used</div>
              <div class="value">34<span class="unit">%</span></div>
            </div>
            <div class="line"></div>
            <div class="metric">
              <div class="metrics-title">Total Storage</div>
              <div class="value">50<span class="unit">MB</span></div>
            </div>
          </div>
        </div>
        <div class="folders-section">
          <div class="top-bar">
            <div class="section-title">Your Folders</div>
            <button class="new-button">
              <img src="/plus-icon.svg" alt="Add">
              New Folder
            </button>
          </div>
          <div class="folder-grid">
            <% if(locals.allFolders) { %>
              <% if(allFolders.length!=0) { allFolders.forEach((folder)=> { %>

                <div class="folder-card">
                  <div class="icon">
                    <img src="/folder-icon.svg" alt="Folder">
                  </div>
                  <div class="card-content">
                    <div class="top-row">
                      <div class="folder-name">
                        <%= folder.name %>
                      </div>
                      <button class="menu-button">
                        <img src="/menu-icon.svg" alt="Folder">
                      </button>
                    </div>
                    <div class="additional-info">300KB • 3 files • <%= new Intl.DateTimeFormat('en-IN', {
                        dateStyle:'medium' } ).format(new Date(folder.createdAt)) %>
                    </div>
                  </div>
                </div>

                <% })}} %>


          </div>
        </div>
      </div>
    </div>


    <dialog class="add-folder-dialog" closeby="any" <%=keepAddFolderDialogOpen? "open" : "" %>>
      <div class="dialog-container">
        <div class="dialog-header">
          <div class="dialog-info">
            <img src="/folder-icon-white.svg" alt="Folder">
            <div class="dialog-name">New Folder</div>
          </div>
          <button class="close-dialog-button">
            <img src="/close-dialog-icon.svg" alt="Close">
          </button>
        </div>
        <div class="dialog-content">
          <% if(locals.errors) { %>
            <%- include("./errors/errors") %>
              <% } %>
                <form action="/folder/new" method="POST">
                  <div class="input-container">
                    <input type="text" placeholder="Enter Folder Name" name="folderName" required
                      value="<%= oldData.folderName%>">
                  </div>
                  <div class="dialog-button-group">
                    <input type="reset" value="Cancel" class="secondary-button">
                    <input type="submit" value="Create" class="primary-button">
                  </div>
                </form>
        </div>
      </div>
      </div>
    </dialog>
</body>
<script src="/script.js"></script>

</html>