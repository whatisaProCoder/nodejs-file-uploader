<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ShareFY</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="shortcut icon" href="/brand-icon.svg" type="image/x-icon">
  <meta name="color-scheme" content="light dark">
</head>

<body>
  <%- include("./partials/header") %>
    <div class="content-container">
      <div class="content">

        <div class="files-section">
          <div class="top-bar">
            <div class="left-group">
              <img src="/folder-icon.svg" alt="Folder" class="folder-icon">
              <div class="section-title">
                <%= folderShareObject.folder.name %>
              </div>
            </div>
          </div>

          <% if(locals.folderShareObject.folder.files) { %>
            <% if(folderShareObject.folder.files.length!=0) { %>
              <div class="files-grid">
                <% folderShareObject.folder.files.forEach((file)=> { %>

                  <div class="file-card">
                    <a class="icon" href="/publicshare/folder/<%=folderShareObject.id%>/file/<%=file.id%>/download">
                      <img src="/file-icon.svg" alt="File">
                    </a>
                    <div class="card-content">
                      <div class="top-row">
                        <a class="file-name"
                          href="/publicshare/folder/<%=folderShareObject.id%>/file/<%=file.id%>/download">
                          <%= file.name %>
                        </a>
                      </div>
                      <a class="additional-info"
                        href="/publicshare/folder/<%=folderShareObject.id%>/file/<%=file.id%>/download">
                        <% if(file.size>1024*1024) { %><%= (file.size/(1024*1024)).toFixed(2) %>MB <% } else { %>
                              <%= (file.size/(1024)).toFixed(2) %>KB <% } %> • <%= file.ext.toUpperCase() %> •
                                    <span id="date">
                                      <%= file.createdAt %>
                                    </span>
                      </a>
                    </div>
                  </div>


                  <% }) %>

              </div>

              <%} else {%>
                <div class="empty">
                  <div class="line-1"></div>No files yet!<div class="line-2"></div>
                </div>
                <% }} %>
        </div>


        <div class="centered-container">
          <div class="user-info">
            <img src="/shared-icon.svg" alt="Shared">
            Shared by <%=folderShareObject.user.firstName%>
              <%=folderShareObject.user.lastName%>
          </div>
        </div>
      </div>
    </div>
</body>
<script src="/script.js"></script>

</html>