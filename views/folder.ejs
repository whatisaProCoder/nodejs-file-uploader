<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ShareFY</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="shortcut icon" href="/brand-icon.svg" type="image/x-icon">
</head>

<body>
  <%- include("./partials/header") %>
    <div class="content-container">
      <div class="content">

        <div class="files-section">
          <div class="top-bar">
            <div class="left-group">
              <a class="back-button" href="/folder/all">
                <img src="/back-button.svg" alt="Go Back">
              </a>
              <img src="/folder-icon.svg" alt="Folder" class="folder-icon">
              <div class="section-title">
                <%= folder.name %>
              </div>
            </div>
            <button class="new-button">
              <img src="/plus-icon.svg" alt="Add">
              New File
            </button>
          </div>
          <% if(locals.errors) { %>
            <%- include("./errors/errors") %>
              <% } %>

                <% if(locals.folder.files) { %>
                  <% if(folder.files.length!=0) { %>
                    <div class="files-grid">
                      <% folder.files.forEach((file)=> { %>

                        <div class="file-card">
                          <div class="icon">
                            <img src="/file-icon.svg" alt="File">
                          </div>
                          <div class="card-content">
                            <div class="top-row">
                              <div class="file-name">
                                <%= file.name %>
                              </div>
                              <button class="file-menu-button" id="file-menu-<%= file.id %>"
                                data-file-id="<%= file.id %>" data-file-name="<%= file.name %>">
                                <img src="/menu-icon.svg" alt="File">
                              </button>
                            </div>
                            <div class="additional-info">300KB • JPEG • <span id="date">
                                <%= file.createdAt %>
                              </span>
                            </div>
                          </div>
                        </div>


                        <% }) %>

                    </div>

                    <%} else {%>
                      <div class="empty">
                        <div class="line-1"></div>No files yet! Upload a file to continue.<div class="line-2"></div>
                      </div>
                      <% }} %>
        </div>
      </div>
    </div>


    <dialog class="add-folder-dialog" closeby="any">
      <div class="dialog-container">
        <div class="dialog-header">
          <div class="dialog-info">
            <img src="/folder-icon-white.svg" alt="Folder">
            <div class="dialog-name">New Folder</div>
          </div>
          <button class="close-dialog-button">
            <img src="/close-dialog-icon.svg" alt="Close">
          </button>
        </div>
        <div class="dialog-content">
          <form action="/folder/new" method="POST">
            <div class="input-container">
              <input type="text" placeholder="Enter Folder Name" name="folderName" required>
            </div>
            <div class="dialog-button-group">
              <input type="reset" value="Cancel" class="secondary-button">
              <input type="submit" value="Create" class="primary-button">
            </div>
          </form>
        </div>
      </div>
      </div>
    </dialog>


    <dialog class="edit-folder-dialog" closeby="any">
      <div class="dialog-container">
        <div class="dialog-header">
          <div class="dialog-info">
            <img src="/edit-icon.svg" alt="Edit">
            <div class="dialog-name">Edit</div>
          </div>
          <button class="close-dialog-button">
            <img src="/close-dialog-icon.svg" alt="Close">
          </button>
        </div>
        <div class="dialog-content">
          <div class="folder-info">
            <img src="/folder-icon.svg" alt="Folder">
            <div class="folder-name">Test123</div>
          </div>

          <form method="POST">
            <div class="input-container">
              <input type="text" placeholder="Edit Folder Name" name="folderName" required
                id="edit-folder-name-input-field">
            </div>
            <div class="dialog-button-group">
              <input type="reset" value="Cancel" class="secondary-button">
              <input type="submit" value="Rename" class="primary-button">
            </div>
          </form>

        </div>
      </div>
      </div>
    </dialog>



    <dialog class="delete-folder-dialog" closeby="any">
      <div class="dialog-container">
        <div class="dialog-header">
          <div class="dialog-info">
            <img src="/delete-icon.svg" alt="Edit">
            <div class="dialog-name">Delete</div>
          </div>
          <button class="close-dialog-button">
            <img src="/close-dialog-icon.svg" alt="Close">
          </button>
        </div>
        <div class="dialog-content">
          <div class="folder-info">
            <img src="/folder-icon.svg" alt="Folder">
            <div class="folder-name">Test123</div>
          </div>

          <div class="action-info">
            <div class="prompt">Are you sure you want to delete?</div>
            <div class="red-chip">You’ll loose files in this folder, if any</div>
          </div>

          <form method="POST">
            <div class="dialog-button-group">
              <input type="reset" value="Cancel" class="secondary-button" id="delete-dialog-cancel-button">
              <input type="submit" value="Delete" class="primary-button">
            </div>
          </form>

        </div>
      </div>
      </div>
    </dialog>
</body>
<script src="/script.js"></script>

</html>