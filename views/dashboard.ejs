            <div class="section-title">Your Folders</div>
            <button class="new-button">
              <img src="/plus-icon.svg" alt="Add">
              New Folder
            </button>
          </div>
          <div class="folder-grid">
            <div class="folder-card">
              <div class="icon">
                <img src="/folder-icon.svg" alt="Folder">
              </div>
